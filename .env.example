# ==========================================
# Awaaz Pay — Environment Configuration
# ==========================================

# Server configuration
PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001

# ------------------------------------------
# PayPal Sandbox API
# (Obtain from https://developer.paypal.com/dashboard)
# ------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
# Business account email that owns the Sandbox REST app and funds Payouts.
# The Payouts API sender is this business account; a personal Sandbox account
# is not the REST API sender in this flow.
PAYPAL_SANDBOX_MERCHANT_EMAIL=merchant@sandbox.paypal.com
# Optional known demo recipients. These are Sandbox account emails, not passwords.
PAYPAL_SANDBOX_VEGETABLE_VENDOR_EMAIL=vegetable-vendor@business.example.com
PAYPAL_SANDBOX_MILK_VENDOR_EMAIL=milk-vendor@business.example.com
# Cab driver recipient email is normally obtained from their QR or typed email.
# This optional value is used only for the built-in Ravi Cabs demo recipient.
PAYPAL_SANDBOX_CAB_DRIVER_EMAIL=cab-driver@business.example.com
# Legacy override for the built-in Ravi Cabs merchant QR; prefer CAB_DRIVER_EMAIL.
PAYPAL_SANDBOX_MERCHANT_RECIPIENT_EMAIL=
# Leave blank: unknown recipients must provide a QR or explicit Sandbox email.
PAYPAL_SANDBOX_RECEIVER_EMAIL=

# ------------------------------------------
# LLM Providers for Intent Parsing & Analysis
# Primary: Google Gemini | Secondary: Groq Llama 3
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------
# Demo & Evaluation Flags
# ------------------------------------------
# LLM_DEMO_CACHE: When 'true', uses llm_demo_cache.json for instant offline responses
LLM_DEMO_CACHE=true

# DEMO_SKIP_COOLING: When 'true', bypasses 24h cooling-off for newly added contacts in demos
DEMO_SKIP_COOLING=true

# DEMO_AUTH_BYPASS: When 'true', allows anonymous access to API routes for quick testing/demos
DEMO_AUTH_BYPASS=true

# Separate Awaaz Pay guardian login (do not use PayPal Sandbox credentials here)
FAMILY_DASHBOARD_EMAIL=family@example.com
FAMILY_DASHBOARD_PASSWORD=replace_with_a_unique_app_password

# Contact cooling-off duration in hours (defaults to 24 if unset)
CONTACT_COOLING_OFF_HOURS=24

# ------------------------------------------
# Storage
# ------------------------------------------
# Neon PostgreSQL Serverless DB (required for the application database)
# Example: postgresql://neondb_owner:pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
