# Server configuration
PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=https://your-service-name.onrender.com

# PayPal Sandbox API (placeholders - do not commit real credentials)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# LLM Providers (placeholders - do not commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# SQLite Database path (optional, defaults to server/data/awaaz_pay.db)
DATABASE_PATH=
