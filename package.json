{
  "name": "awaaz-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A voice-first wallet for blind and low-literacy users in India",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=server && npm run build --workspace=web",
    "start": "node server/dist/index.js",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "paypal:check": "npm run paypal:check --workspace=server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
